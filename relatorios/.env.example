# Copie para .env (que NÃO vai para o Git) e preencha. Veja docs/06_IMPLANTACAO.md.
# Endereço do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA "anon" (Project Settings > API). É feita para ficar no navegador; quem protege os dados é o RLS.
# NUNCA coloque aqui a chave "service_role" (secreta). O build recusa essa chave.
SUPABASE_ANON_KEY=
# Só para scripts/backup.mjs (conta de administrador e frase que cifra o arquivo de backup)
BACKUP_EMAIL=
BACKUP_PASSWORD=
BACKUP_PASSPHRASE=
