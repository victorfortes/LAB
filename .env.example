# Copie para .env (nunca versionar). Nenhum valor real deve estar neste arquivo.
NGA_MODE=simulated            # simulated | live
DATABASE_URL=postgres://nga:CHANGE_ME@localhost:5432/nga_prazos
JWT_SECRET=                   # >= 32 bytes aleatórios (openssl rand -base64 48)
NGA_WRITE_ENABLED=false       # só true em ambiente de teste previamente autorizado
PORT=8787
# Somente modo live / recon (sessão autenticada manualmente pelo usuário):
ASTREA_BASE_URL=
ASTREA_PROFILE_DIR=.astrea-profile
NGA_DEFAULT_DAY_UNIT=dias_corridos   # modalidade presumida quando o texto não diz úteis/corridos (decisão do usuário)
NGA_AUTHORIZED_CLIENT_REGEX=            # escopo por cliente (regex, case-insensitive), ex.: copel
NGA_LIVE_MAX=12                         # máx. de publicações lidas por execução no Astrea real
NGA_HEADLESS=true                       # false = mostra o navegador do Playwright

# Operação real (ver README): normalmente nada disso é digitado; DATABASE_URL vem do Keychain (scripts/set-db-url.sh)
# NGA_DB_CA=config/supabase-ca.pem
# NGA_LIVE_MAX=300            # máx. de publicações lidas por Play
# NGA_PUBLICATION_LIMIT=300
# NGA_ALLOW_ALL_CLIENTS=yes   # libera o escopo "todo o escritório" no Play (admin)
# NGA_MAX_REAL_WRITES=25      # teto de criações por execução (produção)
