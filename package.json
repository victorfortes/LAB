{
  "name": "nga-prazos",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server/main.ts --demo",
    "demo": "bun run build:web && bun src/server/main.ts --demo",
    "start": "bun src/server/main.ts",
    "build:web": "cd web && vite build",
    "web:dev": "cd web && vite",
    "migrate": "bun scripts/migrate.ts",
    "create-user": "bun scripts/create-user.ts",
    "recon": "bun scripts/recon.ts",
    "demo:cli": "bun scripts/demo-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "live:check": "bun scripts/live-check.ts",
    "live:login": "bun scripts/live-login.ts",
    "live:app": "bun run build:web && bun src/server/main.ts --live-local",
    "live:cleanup-test": "bun scripts/live-cleanup-test.ts",
    "start:leitura": "scripts/start.sh",
    "start:producao": "scripts/start.sh producao",
    "stop": "scripts/stop.sh",
    "live:pilot": "NGA_REAL_PILOT=yes-i-authorize bun run live:app"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-x64"
  ]
}