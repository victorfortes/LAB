# Copie para .env e preencha. O .env nunca vai para o repositório.

# --- banco ---
NGA_PG_DATABASE=nga_nexus
# Dono do schema: usado SÓ pela migração, nunca pela aplicação.
NGA_PG_ADMIN_USER=postgres
NGA_PG_ADMIN_PASSWORD=
# Papel da aplicação, criado pela migração 004. Não fura o RLS, e é isso que
# mantém o isolamento entre clientes de pé.
NGA_PG_PASSWORD=

# --- arquivos ---
# Assina as URLs temporárias de download (§12.4). Mínimo de 32 caracteres.
# Sem ele, um segredo é sorteado a cada processo: os links morrem no reinício
# e não funcionam com mais de uma réplica.
#   openssl rand -base64 48
NGA_SEGREDO_ARQUIVOS=

# --- opcional ---
# Sem chave, a análise documental roda só o determinístico e diz isso na tela.
ANTHROPIC_API_KEY=
# Porta exposta no host.
NGA_PORTA_EXTERNA=8790
